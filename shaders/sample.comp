layout(local_size_x = 64) in;
layout(std430, binding = 2) writeonly buffer Samples { vec2 res[]; };  // per point: terrain height (km), Sun visibility on the ground
layout(std430, binding = 6) readonly buffer Points { vec4 pts[]; };   // per point: unit vector (MOON_ME)
layout(location = 0) uniform uint count;
layout(location = 1) uniform bool sun;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= count) return;
    vec3 n = pts[i].xyz;
    float h = heightAt(n, 0.0);
    res[i] = vec2(h, sun ? visibility(n * (R + h), sunDir.xyz, sunDir.w, 0.03) : 1.0);
}
